<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>CropGrowthRate</RootNamespace>
    <AssemblyName>CropGrowthRate</AssemblyName>
    <OutputType>Library</OutputType>
    <LangVersion>12.0</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')" />

  <PropertyGroup>
    <DeployToVS Condition="'$(DeployToVS)' == '' and '$(ModOutputPath)' != ''">true</DeployToVS>
    <DeployToVS Condition="'$(DeployToVS)' == ''">false</DeployToVS>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VSPath)/VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VintagestoryLib"><HintPath>$(VSPath)/VintagestoryLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VSPath)/Mods/VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VSPath)/Mods/VSSurvivalMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VSPath)/Lib/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VSPath)/Lib/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="Always" />
    <None Include="assets/**/*.*" CopyToOutputDirectory="Always" LinkBase="assets" />
  </ItemGroup>

  <Target Name="DeployToVS" AfterTargets="Build" Condition="'$(DeployToVS)' == 'true' and '$(ModOutputPath)' != ''">
    <ItemGroup>
      <DllFiles Include="$(OutputPath)$(AssemblyName).dll" />
      <PdbFiles Include="$(OutputPath)$(AssemblyName).pdb" />
      <ModInfo Include="modinfo.json" />
      <AssetFiles Include="assets/**/*.*" />
    </ItemGroup>
    <MakeDir Directories="$(ModOutputPath)" />
    <Copy SourceFiles="@(DllFiles)" DestinationFolder="$(ModOutputPath)" />
    <Copy SourceFiles="@(PdbFiles)" DestinationFolder="$(ModOutputPath)" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    <Copy SourceFiles="@(ModInfo)" DestinationFolder="$(ModOutputPath)" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(ModOutputPath)/assets/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>

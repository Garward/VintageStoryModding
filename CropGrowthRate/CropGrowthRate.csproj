<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>CropGrowthRate</RootNamespace>
    <AssemblyName>CropGrowthRate</AssemblyName>
    <OutputType>Library</OutputType>
    <LangVersion>12.0</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ReferenceVSEssentials>true</ReferenceVSEssentials>
    <ReferenceNewtonsoftJson>true</ReferenceNewtonsoftJson>
  </PropertyGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="Always" />
    <None Include="assets/**/*.*" CopyToOutputDirectory="Always" LinkBase="assets" />
  </ItemGroup>
</Project>

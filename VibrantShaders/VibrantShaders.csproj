<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Output directly to mod folder -->
    <OutputPath>./</OutputPath>
    <AssemblyName>VibrantShaders</AssemblyName>
  </PropertyGroup>

  <Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')" />

  <PropertyGroup>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildProjectDirectory)/dist</PackageOutputPath>
    <GameDirectory Condition="'$(GameDirectory)' == '' and '$(VSPath)' != ''">$(VSPath)</GameDirectory>
    <GameDirectory Condition="'$(GameDirectory)' == '' and '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</GameDirectory>
    <ModsDirectory Condition="'$(ModsDirectory)' == '' and '$(VINTAGE_STORY_MODS)' != ''">$(VINTAGE_STORY_MODS)</ModsDirectory>
    <ConfigLibPath Condition="'$(ConfigLibPath)' == '' and '$(CONFIGLIB_DLL)' != ''">$(CONFIGLIB_DLL)</ConfigLibPath>
    <ConfigLibExtractDir Condition="'$(ConfigLibExtractDir)' == ''">$(MSBuildProjectDirectory)/../compile/configlib_1.12.0</ConfigLibExtractDir>
    <ConfigLibZipPath Condition="'$(ConfigLibZipPath)' == ''">$(MSBuildProjectDirectory)/../compile/configlib_1.12.0.zip</ConfigLibZipPath>
    <ConfigLibPath Condition="'$(ConfigLibPath)' == '' and '$(ModsDirectory)' != ''">$(ModsDirectory)/configlib_1.12.0/configlib.dll</ConfigLibPath>
    <ConfigLibPath Condition="'$(ConfigLibPath)' == ''">$(ConfigLibExtractDir)/configlib.dll</ConfigLibPath>
  </PropertyGroup>

  <Target Name="ExtractConfigLib" BeforeTargets="ResolveReferences" Condition="'$(ConfigLibPath)' != '' and !Exists('$(ConfigLibPath)') and Exists('$(ConfigLibZipPath)')">
    <MakeDir Directories="$(ConfigLibExtractDir)" />
    <Exec Command="python3 -c &quot;import zipfile; zipfile.ZipFile(r'$(ConfigLibZipPath)').extractall(r'$(ConfigLibExtractDir)')&quot;" />
  </Target>

  <Target Name="ValidateVintageStoryPaths" BeforeTargets="ResolveReferences" Condition="'$(GameDirectory)' == '' or '$(ConfigLibPath)' == ''">
    <Error Text="Set GameDirectory and ConfigLibPath in Directory.Build.local.props, pass /p:GameDirectory=... /p:ConfigLibPath=..., or set VINTAGE_STORY and CONFIGLIB_DLL." />
  </Target>

  <!-- VS API References -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GameDirectory)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(GameDirectory)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameDirectory)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ConfigLib Reference -->
  <ItemGroup>
    <Reference Include="configlib">
      <HintPath>$(ConfigLibPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PackageDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(PackageOutputPath)" />
    <Delete Files="$(PackageOutputPath)/$(AssemblyName).zip" />
    <Exec Command="python3 -c &quot;import os, zipfile; root=r'$(MSBuildProjectDirectory)'; out=r'$(PackageOutputPath)/$(AssemblyName).zip'; z=zipfile.ZipFile(out,'w',zipfile.ZIP_DEFLATED); dll=os.path.join(root,r'$(OutputPath)$(AssemblyName).dll'); pdb=os.path.join(root,r'$(OutputPath)$(AssemblyName).pdb'); [z.write(p,a) for p,a in [(dll,'$(AssemblyName).dll'),(pdb,'$(AssemblyName).pdb'),(os.path.join(root,'modinfo.json'),'modinfo.json')] if os.path.exists(p)]; assets=os.path.join(root,'assets'); [z.write(os.path.join(dp,f), os.path.relpath(os.path.join(dp,f), root)) for dp,_,fs in os.walk(assets) for f in fs] if os.path.isdir(assets) else None; z.close()&quot;" />
    <Message Text="Packaged: $(PackageOutputPath)/$(AssemblyName).zip" Importance="high" />
  </Target>

</Project>

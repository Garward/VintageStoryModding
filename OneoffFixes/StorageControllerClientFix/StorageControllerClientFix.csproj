<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>./</OutputPath>
    <AssemblyName>StorageControllerClientFix</AssemblyName>
    <RootNamespace>StorageControllerClientFix</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <PackageFileName>$(AssemblyName)-v$(Version).zip</PackageFileName>
  </PropertyGroup>

  <PropertyGroup>
    <GameDirectory>/home/garward/Games/Games/VintageStory/vintagestory</GameDirectory>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildProjectDirectory)/dist</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GameDirectory)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(GameDirectory)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(GameDirectory)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDirectory)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="storagecontroller">
      <HintPath>./lib/storagecontroller.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PackageDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(PackageOutputPath)" />
    <Delete Files="$(PackageOutputPath)/$(PackageFileName)" />
    <Exec Command="python3 -c &quot;import os, zipfile; root=r'$(MSBuildProjectDirectory)'; out=r'$(PackageOutputPath)/$(PackageFileName)'; z=zipfile.ZipFile(out,'w',zipfile.ZIP_DEFLATED); paths=[(r'$(TargetPath)','$(AssemblyName).dll'),(r'$(TargetDir)$(AssemblyName).pdb','$(AssemblyName).pdb'),(os.path.join(root,'modinfo.json'),'modinfo.json')]; [z.write(p,a) for p,a in paths if os.path.exists(p)]; z.close()&quot;" />
    <Message Text="Packaged: $(PackageOutputPath)/$(PackageFileName)" Importance="high" />
  </Target>
</Project>

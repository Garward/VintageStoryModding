    { "code": "blood", "namePattern": "Blood", "category": "resource", "operation": "flat_or_percent", "appliesTo": "blood resource" },
    { "code": "damage_absorbed_by_mana", "namePattern": "Damage Absorbed by Mana", "category": "absorb", "operation": "percent", "percent": true, "appliesTo": "incoming damage split to mana" },
    { "code": "health_restoration_to_blood", "namePattern": "Health Restoration to Blood", "category": "resource_conversion", "operation": "flag", "appliesTo": "health restoration" },
    { "code": "{resource}_regen_percent", "namePattern": "Regenerate {resource} Percent", "category": "regen", "axes": ["resource"], "operation": "percent_of_max_per_second", "percent": true, "appliesTo": "resource regeneration" }
  ]

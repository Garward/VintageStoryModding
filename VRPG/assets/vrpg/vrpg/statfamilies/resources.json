    { "code": "{element}_damage_leech_as_{resource}", "namePattern": "Leech {value}% of {element} Damage as {resource}", "category": "leech", "axes": ["element", "resource"], "operation": "percent_of_damage_as_resource", "percent": true, "minValue": 0, "appliesTo": "matching element damage" },

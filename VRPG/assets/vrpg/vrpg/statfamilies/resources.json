    { "code": "{resource}_leech_cap", "namePattern": "Legacy {resource} Leech Cap", "category": "legacy_leech", "axes": ["resource"], "operation": "deprecated_alias", "percent": true, "minValue": 0, "maxValue": 10, "appliesTo": "legacy content migration only" },
    { "code": "low_hp_healing", "namePattern": "Healing When Low", "category": "healing", "operation": "increased", "layer": "additive_restore", "percent": true, "baseValue": 0, "appliesTo": "spell healing to low targets" },
    { "code": "out_of_combat_regen", "namePattern": "Out of Combat Regen", "category": "regen", "operation": "increased", "layer": "additive_restore", "percent": true, "baseValue": 0, "appliesTo": "regeneration while not in combat" },
    { "code": "increase_health_healing", "namePattern": "Health Healing Strength", "category": "health_healing", "operation": "increased", "layer": "additive_restore", "percent": true, "baseValue": 0, "appliesTo": "explicit Health healing only" },
    { "code": "increase_magic_shield_restoration", "namePattern": "Magic Shield Restoration Strength", "category": "magic_shield_restoration", "operation": "increased", "layer": "additive_restore", "percent": true, "baseValue": 0, "appliesTo": "explicit Magic Shield restoration only" },

    { "code": "mana_leech_rate_cap", "namePattern": "+{value}% Maximum Mana Leech Rate", "category": "leech_cap", "operation": "add_percent_of_max_per_second_to_cap", "percent": true, "baseValue": 10, "minValue": 10, "maxValue": 25, "appliesTo": "mana leech payout cap; exceptional class/passive sources only" },

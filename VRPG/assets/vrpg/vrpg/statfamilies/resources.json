    { "code": "spell_lifesteal", "namePattern": "Spell Lifesteal", "category": "leech", "operation": "percent_of_damage_as_resource", "percent": true, "baseValue": 0, "minValue": 0, "appliesTo": "spell damage to health" },
    { "code": "spell_mssteal", "namePattern": "Spell Magic Shield Steal", "category": "leech", "operation": "percent_of_damage_as_resource", "percent": true, "baseValue": 0, "minValue": 0, "appliesTo": "spell damage to magic shield" },
    { "code": "dot_lifesteal", "namePattern": "Damage Over Time Lifesteal", "category": "leech", "operation": "percent_of_damage_as_resource", "percent": true, "baseValue": 0, "minValue": 0, "appliesTo": "dot damage to health" },
    { "code": "increased_leech", "namePattern": "Increased Leech", "category": "leech", "operation": "increased", "percent": true, "appliesTo": "all leech amounts" },
    { "code": "health_regen_on_missing_hp", "namePattern": "Health Regen on Missing Health", "category": "regen", "operation": "missing_resource_scaling", "percent": true, "appliesTo": "missing health" },
    { "code": "health", "namePattern": "Health", "category": "resource", "operation": "flat_or_percent", "appliesTo": "maximum health" },
    { "code": "health_regen", "namePattern": "Health Regen", "category": "regen", "operation": "flat", "appliesTo": "health regeneration" },
    { "code": "mana", "namePattern": "Mana", "category": "resource", "operation": "flat_or_percent", "appliesTo": "maximum mana" },
    { "code": "mana_regen", "namePattern": "Mana Regen", "category": "regen", "operation": "flat", "appliesTo": "mana regeneration" },
    { "code": "magic_shield", "namePattern": "Magic Shield", "category": "resource", "operation": "flat_or_percent", "appliesTo": "maximum magic shield" },
    { "code": "magic_shield_regen", "namePattern": "Magic Shield Regen", "category": "regen", "operation": "flat", "appliesTo": "magic shield regeneration" },

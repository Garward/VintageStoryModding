{
  "code": "vrpg:resources",
  "name": "Resource and Recovery Stat Families",
  "sourceReference": "Mine-And-Slash-Rework ResourceStats.java, DatapackStats.java, and StatsRegister.java, summarized as original VRPG data.",
  "conversionNote": "Health maps directly to Vintage Story. Mana, magic shield, and blood are VRPG systems; only resources used by the current build should occupy HUD space.",
  "axes": [
    { "code": "resource", "values": ["health", "magic_shield", "mana", "blood"] },
    { "code": "element", "values": ["physical", "fire", "cold", "lightning", "rust", "elemental", "all"] },
    { "code": "attack_type", "values": ["attack", "spell", "dot"] },
    { "code": "action", "values": ["hit", "crit", "kill", "block"] }
  ],
  "families": [
    { "code": "health_damage_leech", "namePattern": "Leech {value}% of Damage as Health", "category": "leech", "operation": "percent_of_effective_damage_to_reservoir", "percent": true, "baseValue": 0, "minValue": 0, "appliesTo": "qualifying post-mitigation damage; shared health leech reservoir" },
    { "code": "mana_damage_leech", "namePattern": "Leech {value}% of Damage as Mana", "category": "leech", "operation": "percent_of_effective_damage_to_reservoir", "percent": true, "baseValue": 0, "minValue": 0, "appliesTo": "qualifying post-mitigation damage; shared mana leech reservoir" },

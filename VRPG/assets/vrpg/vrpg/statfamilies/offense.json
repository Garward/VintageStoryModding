{
  "code": "vrpg:offense",
  "name": "Offense Stat Families",
  "sourceReference": "Mine-And-Slash-Rework OffenseStats.java and StatsRegister.java, summarized as original VRPG data.",
  "conversionNote": "Use flat/increased/more aggregation. Damage-related percent stats feed VRPG damage layers rather than directly editing item damage.",
  "axes": [
    { "code": "element", "values": ["physical", "fire", "cold", "lightning", "rust", "elemental", "all"] },
    { "code": "weapon", "values": ["axe", "staff", "trident", "sword", "bow", "crossbow"] },
    { "code": "playstyle", "values": ["str", "dex", "int"] },
    { "code": "spell_tag", "values": ["registry:spell_tags"] }
  ],
  "families": [
    { "code": "ignore_ele_res", "namePattern": "Criticals Ignore Elemental Resists", "category": "offense", "operation": "flag", "percent": true, "minValue": 0, "maxValue": 1, "appliesTo": "critical elemental damage", "conversion": "boolean stat; value > 0 skips resistance/penetration resolution" },
    { "code": "archmage", "namePattern": "Add {value}% of Mana to Spell Damage", "category": "offense", "operation": "add_from_percent_of_stat", "layer": "flat_damage", "percent": true, "minValue": 0, "maxValue": 100, "appliesTo": "mana-cost spells", "conversion": "flatDamage += mana * value / 100, then apply spell damage effectiveness" },
    { "code": "archmage_mana_cost", "namePattern": "Add {value}% of Mana to Mana Cost", "category": "spell_cost", "operation": "add_from_percent_of_stat", "percent": true, "minValue": 0, "maxValue": 100, "appliesTo": "mana-cost spells", "conversion": "manaCost += mana * value / 100" },
    { "code": "all_{element}_damage", "namePattern": "{element} Damage", "category": "elemental_damage", "axes": ["element"], "operation": "increased", "layer": "additive_damage", "percent": true, "minValue": 0, "appliesTo": "damage matching element" },
    { "code": "{playstyle}_dmg", "namePattern": "{playstyle} Damage", "category": "style_damage", "axes": ["playstyle"], "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "damage with playstyle tag" },
    { "code": "spell_{element}_damage", "namePattern": "{element} Spell Damage", "category": "spell_damage", "axes": ["element"], "operation": "increased", "layer": "additive_damage", "percent": true, "minValue": 0, "appliesTo": "spell damage matching element" },
    { "code": "{weapon}_damage", "namePattern": "{weapon} Damage", "category": "weapon_damage", "axes": ["weapon"], "operation": "increased", "layer": "additive_damage", "percent": true, "minValue": 0, "appliesTo": "damage caused by matching weapon type" },
    { "code": "ele_{weapon}_damage", "namePattern": "Elemental {weapon} Damage", "category": "weapon_damage", "axes": ["weapon"], "operation": "increased", "layer": "additive_damage", "percent": true, "minValue": 0, "appliesTo": "elemental damage caused by matching weapon type" },
    { "code": "{element}_any_wep_damage", "namePattern": "{element} Weapon Damage", "category": "weapon_damage", "axes": ["element"], "operation": "increased", "layer": "additive_damage", "percent": true, "minValue": 0, "appliesTo": "weapon damage matching element" },
    { "code": "critical_hit", "namePattern": "Critical Chance", "category": "critical", "operation": "chance", "percent": true, "baseValue": 5, "minValue": 0, "maxValue": 100, "appliesTo": "non-dot damage", "conversion": "final = clamp((5 base + flat gear and upgrade bonuses) * (1 + summed Additional Critical Chance / 100) * product(More Critical Chance), 0, cap); add modifiers are Flat, increased modifiers are displayed as Additional, and more modifiers are exceptional multipliers" },
    { "code": "critical_damage", "namePattern": "Critical Damage", "category": "critical", "operation": "multiplier_percent", "layer": "crit_damage", "percent": true, "baseValue": 150, "minValue": 0, "maxValue": 500, "appliesTo": "critical non-dot damage", "conversion": "critical hits begin at 150% total hit damage before critical-specific increased and More/Less layers" },
    { "code": "non_crit_damage", "namePattern": "Non Critical Damage", "category": "critical", "operation": "increased", "layer": "additive_damage", "percent": true, "minValue": -100, "maxValue": 500, "appliesTo": "non-critical damage" },
    { "code": "accuracy", "namePattern": "Accuracy", "category": "hit", "operation": "rating", "minValue": 0, "appliesTo": "hit and crit confirmation", "conversion": "rating reduces target dodge/evasion chance" },
    { "code": "projectile_damage", "namePattern": "Projectile Damage", "category": "projectile", "operation": "increased", "layer": "additive_damage", "percent": true, "baseValue": 0, "appliesTo": "projectiles and ranged basic attacks" },
    { "code": "area_dmg", "namePattern": "Area Damage", "category": "area", "operation": "increased", "layer": "additive_damage", "percent": true, "baseValue": 0, "appliesTo": "area-tagged effects" },
    { "code": "trap_area_dmg", "namePattern": "Trap Area Damage", "category": "area", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "trap + area effects" },
    { "code": "dot_damage", "namePattern": "Damage Over Time", "category": "dot", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "dot attacks" },
    { "code": "dot_multi", "namePattern": "Damage Over Time Multiplier", "category": "dot", "operation": "multiplier_percent", "layer": "dot_dmg_multi", "percent": true, "appliesTo": "dot attacks" },
    { "code": "total_damage", "namePattern": "Total Damage", "category": "offense", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "all damage" },
    { "code": "attack_damage", "namePattern": "Attack Damage", "category": "attack", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "attack damage" },
    { "code": "{element}_dot_damage", "namePattern": "{element} Damage Over Time", "category": "dot", "axes": ["element"], "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "dot damage matching element" },
    { "code": "double_attack_damage", "namePattern": "Double Attack Damage Chance", "category": "attack", "operation": "chance", "layer": "double_damage", "percent": true, "minValue": 0, "maxValue": 100, "appliesTo": "attack damage", "conversion": "roll chance; on success double_damage layer is x2" },
    { "code": "{spell_tag}_damage", "namePattern": "{spell_tag} Damage", "category": "tag_damage", "axes": ["spell_tag"], "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "damage with spell/effect tag" },
    { "code": "damage_to_cursed", "namePattern": "Damage to Cursed Targets", "category": "conditional_damage", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "targets with curse" },
    { "code": "summon_damage", "namePattern": "Summon Damage", "category": "summon", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "summoned entities" },
    { "code": "damage_when_low_hp", "namePattern": "Damage When Low", "category": "conditional_damage", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "source low health/magic shield" },
    { "code": "damage_when_target_full_hp", "namePattern": "Damage to Full Health Targets", "category": "conditional_damage", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "target full health/magic shield" },
    { "code": "{element}_damage_when_target_low_hp", "namePattern": "{element} Damage to Low Targets", "category": "conditional_damage", "axes": ["element"], "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "target low health/magic shield and matching element" },
    { "code": "damage_when_target_low_hp", "namePattern": "Damage to Low Targets", "category": "conditional_damage", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "target low health/magic shield" },
    { "code": "damage_to_living", "namePattern": "Damage to Living", "category": "conditional_damage", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "living targets" },
    { "code": "damage_to_undead", "namePattern": "Damage to Undead", "category": "conditional_damage", "operation": "increased", "layer": "additive_damage", "percent": true, "appliesTo": "undead targets" },
    { "code": "missing_mana_damage_per_10", "namePattern": "Damage per 10% Missing Mana", "category": "conditional_damage", "operation": "missing_resource_scaling", "layer": "additive_damage", "percent": true, "appliesTo": "source missing mana", "conversion": "effective = floor(missingManaPercent / 10) * value" }
  ]
}

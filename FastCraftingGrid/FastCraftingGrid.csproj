<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>./</OutputPath>
    <AssemblyName>FastCraftingGrid</AssemblyName>
    <RootNamespace>FastCraftingGrid</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <PackageFileName>$(AssemblyName)-v$(Version).zip</PackageFileName>
  </PropertyGroup>

  <PropertyGroup>
    <GameDirectory>/home/garward/Games/Games/VintageStory/vintagestory</GameDirectory>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildProjectDirectory)/dist</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GameDirectory)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(GameDirectory)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDirectory)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="Always" />
    <None Include="LICENSE" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="PackageDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/scripts/package.sh&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(MSBuildProjectDirectory)/$(OutputPath)&quot;" />
  </Target>
</Project>
